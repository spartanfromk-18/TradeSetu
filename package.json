{
  "name": "tradesetu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "edge:dev": "wrangler dev --config edge/wrangler.toml",
    "edge:deploy": "wrangler deploy --config edge/wrangler.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "latest",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vitest": "latest",
    "wrangler": "^4.151.2"
  }
}
